{
  "name": "@deploy-flow/source",
  "version": "0.0.0",
  "packageManager": "pnpm@10.6.5",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm nx dev @deploy-flow/client",
    "dev:client": "pnpm nx dev @deploy-flow/client",
    "dev:api": "pnpm nx serve @deploy-flow/api",
    "cypress:client:open": "env -u ELECTRON_RUN_AS_NODE pnpm nx run @deploy-flow/client:open-cypress",
    "e2e:client": "env -u ELECTRON_RUN_AS_NODE pnpm nx run @deploy-flow/client:e2e",
    "e2e:client:catalog": "env -u ELECTRON_RUN_AS_NODE pnpm nx run @deploy-flow/client:e2e -- --spec=cypress/e2e/catalog.cy.ts",
    "graphql-schema-generate:api": "pnpm nx run @deploy-flow/api:graphql-schema-generate",
    "graphql-codegen:client": "pnpm run graphql-schema-generate:api && pnpm exec graphql-codegen --config codegen.yml",
    "build": "pnpm nx run-many -t build --projects=@deploy-flow/client,@deploy-flow/api",
    "lint": "pnpm nx run-many -t lint --projects=@deploy-flow/client,@deploy-flow/api -- --max-warnings=0",
    "lint:fix": "pnpm nx run-many -t lint --projects=@deploy-flow/client,@deploy-flow/api -- --fix",
    "prepare": "node -e \"const fs=require('node:fs');const cp=require('node:child_process');const path=require('node:path');const root=process.cwd();const gitDir=path.join(root,'.git');const bin=path.join(root,'node_modules','.bin',process.platform==='win32'?'husky.cmd':'husky');if(!fs.existsSync(gitDir)||!fs.existsSync(bin))process.exit(0);const result=cp.spawnSync(bin,{stdio:'inherit'});process.exit(typeof result.status==='number'?result.status:0);\""
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/typescript": "^5.0.9",
    "@graphql-codegen/typescript-operations": "^5.0.9",
    "@graphql-codegen/typescript-react-apollo": "^4.4.1",
    "@nx/cypress": "22.5.1",
    "@nx/eslint": "22.5.1",
    "@nx/eslint-plugin": "22.5.1",
    "@nx/jest": "22.5.1",
    "@nx/js": "22.5.1",
    "@nx/nest": "^22.5.1",
    "@nx/node": "22.5.1",
    "@nx/react": "^22.5.1",
    "@nx/vite": "22.5.1",
    "@nx/web": "22.5.1",
    "@nx/webpack": "22.5.1",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^4.0.0",
    "babel-jest": "^30.0.2",
    "cypress": "^15.8.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-cypress": "^3.5.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "22.5.1",
    "prettier": "^2.6.2",
    "sass": "^1.55.0",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "webpack-cli": "^5.1.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "axios": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@apollo/protobufjs",
      "@parcel/watcher",
      "@scarf/scarf",
      "@swc/core",
      "cypress",
      "esbuild",
      "less",
      "nx",
      "unrs-resolver"
    ]
  }
}
