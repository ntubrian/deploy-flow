            {
              "type": "text",
              "id": "Zcp0T",
              "name": "job1",
              "fill": "#000000",
              "content": "- ci: checkout, setup node/pnpm, cache, nx affected -t lint,test,build",
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "axlBk",
              "name": "job2",
              "fill": "#000000",
              "content": "- package: docker build for apps/web and apps/api",
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "6V9jJ",
              "name": "job3",
              "fill": "#000000",
              "content": "- publish: docker login + push to GHCR/ECR with immutable tag (commit SHA)",
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "O2L8g",
              "name": "job4",
              "fill": "#000000",
              "content": "- deploy: ssh/ssm to EC2, docker compose pull + up -d, run DB migration",
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "E8T3E",
              "name": "job5",
              "fill": "#000000",
              "content": "- verify: health endpoint check; if failed, roll back to previous stable tag",
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
