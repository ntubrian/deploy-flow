        {
          "type": "text",
          "id": "MFmwJ",
          "x": 226,
          "y": 1133,
          "name": "前端 完成 捐款項目列表刻板 能夠實現無限滾動出現更多卡片 能夠於搜尋框中輸入關鍵字搜尋 若不確定實際功能實現，可參考街口 App > 公益捐款項目 > 搜尋 後端 請由畫面想像自定義 API Spec 實現 API 功能（列表、分頁查詢) - 可用 Mock Data",
          "fill": "#000000ff",
          "textGrowth": "fixed-width",
          "width": 2088,
          "content": "前端\n完成 捐款項目列表刻板\n能夠實現無限滾動出現更多卡片\n能夠於搜尋框中輸入關鍵字搜尋\n若不確定實際功能實現，可參考街口 App > 公益捐款項目 > 搜尋\n\n後端\n請由畫面想像自定義 API Spec  \n實現 API 功能（列表、分頁查詢) - 可用 Mock Data",
          "textAlignVertical": "middle",
          "fontFamily": "Play",
          "fontSize": 70,
          "fontWeight": "normal"
        }
      ]
