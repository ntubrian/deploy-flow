NODE_ENV=development
APP_STAGE=local

APP_PORT=3000
API_PREFIX=api
APP_CORS_ORIGINS=http://localhost:4200
GRAPHQL_PATH=graphql

# For APP_STAGE=staging/production, database connection settings and web gate secrets
# are read from AWS Systems Manager Parameter Store.
AWS_REGION=ap-northeast-1
AWS_SSM_PARAMETER_PREFIX=/deploy-flow

# Optional overrides for APP_STAGE=local Docker Postgres defaults.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=deploy_flow
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_SSL_ROOT_CERT_PATH=
DB_LOGGING=false

# Local-only web gate secrets. staging/production ignore these and read from SSM.
WEB_GATE_SHARED_SECRET=local-dev-shared-secret
WEB_GATE_SESSION_SECRET=local-dev-session-secret
WEB_GATE_SESSION_TTL_SECONDS=86400
