{
  "name": "@deploy-flow/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@deploy-flow/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@deploy-flow/api:build:development"
          },
          "production": {
            "buildTarget": "@deploy-flow/api:build:production"
          }
        }
      },
      "dev-db-up": {
        "executor": "nx:run-commands",
        "options": {
          "command": "docker compose -f ../../docker-compose.dev.yml up -d postgres",
          "cwd": "apps/api"
        }
      },
      "dev-db-down": {
        "executor": "nx:run-commands",
        "options": {
          "command": "docker compose -f ../../docker-compose.dev.yml down",
          "cwd": "apps/api"
        }
      },
      "db-migration-run": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec ts-node --project ./tsconfig.app.json -r tsconfig-paths/register ./src/database/run-migrations.ts",
          "cwd": "apps/api"
        }
      },
      "db-migration-revert": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec ts-node --project ./tsconfig.app.json -r tsconfig-paths/register ./src/database/revert-last-migration.ts",
          "cwd": "apps/api"
        }
      },
      "db-migration-show": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bash -lc 'export TS_NODE_PROJECT=./tsconfig.app.json && pnpm exec typeorm-ts-node-commonjs migration:show -d ./src/database/typeorm.cli-datasource.ts'",
          "cwd": "apps/api"
        }
      },
      "db-migration-create": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bash -lc 'test -n \"{args.name}\" && export TS_NODE_PROJECT=./tsconfig.app.json && pnpm exec typeorm-ts-node-commonjs migration:create ./src/database/migrations/{args.name}'",
          "cwd": "apps/api"
        }
      },
      "db-migration-generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bash -lc 'test -n \"{args.name}\" && export TS_NODE_PROJECT=./tsconfig.app.json && pnpm exec typeorm-ts-node-commonjs migration:generate ./src/database/migrations/{args.name} -d ./src/database/typeorm.cli-datasource.ts'",
          "cwd": "apps/api"
        }
      },
      "db-seed-run": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec ts-node --project ./tsconfig.app.json -r tsconfig-paths/register ./src/database/run-seeds.ts",
          "cwd": "apps/api"
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@apollo/server": "^5.4.0",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-ssm": "^3.1010.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "graphql": "^16.13.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.1.13",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.2.2",
    "tsconfig-paths": "^4.2.0"
  }
}
